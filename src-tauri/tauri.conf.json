{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "opencode-desktop",
  "version": "0.1.0",
  "identifier": "io.github.opencode.desktop",
  "build": {
    "beforeDevCommand": "npx vite",
    "beforeBuildCommand": "npx vite build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenCode Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "decorations": true,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3"
        ]
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": []
    }
  }
}
